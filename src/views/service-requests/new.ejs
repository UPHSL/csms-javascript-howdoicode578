<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Submit Service Request</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>
  <main class="form-container">
    <section class="card">
      <h1>Submit Service Request</h1>

      <p class="muted-text">
        Enter the Resident and Service Request information below.
      </p>

      <% if (errorMessage) { %>
        <div class="alert alert-error">
          <%= errorMessage %>
        </div>
      <% } %>

      <% if (errors.length > 0) { %>
        <div class="alert alert-error">
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form
        class="resident-form"
        method="POST"
        action="/service-requests"
      >
        <div class="form-group">
          <label for="residentId">
            Resident ID
          </label>

          <input
            type="number"
            id="residentId"
            name="residentId"
            min="1"
            step="1"
            value="<%= serviceRequest.residentId ?? '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="serviceType">
            Service Type
          </label>

          <input
            type="text"
            id="serviceType"
            name="serviceType"
            value="<%= serviceRequest.serviceType ?? '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            rows="5"
            required
          ><%= serviceRequest.description ?? '' %></textarea>
        </div>

        <div class="form-group">
          <label for="dateRequested">
            Date Requested
          </label>

          <input
            type="date"
            id="dateRequested"
            name="dateRequested"
            value="<%= serviceRequest.dateRequested ?? '' %>"
            required
          >
        </div>

        <p class="muted-text">
          New Service Requests are automatically assigned a generated ID
          and a Pending status.
        </p>

        <div class="form-actions">
          <button
            class="button button-primary"
            type="submit"
          >
            Submit Request
          </button>

          <a
            class="button button-secondary"
            href="/service-requests"
          >
            Cancel
          </a>
        </div>
      </form>

      <p>
        <a class="back-link" href="/residents">
          View Residents
        </a>
      </p>
    </section>
  </main>
</body>
</html>